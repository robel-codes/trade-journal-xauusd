# Copy to .env and change every value. Never commit .env.
XAU_DATABASE_URL=postgresql+psycopg://xau:xau@localhost:5432/xau_lab
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
XAU_SECRET_KEY=replace-with-a-long-random-string-0000000000
# Set to true when served over HTTPS
XAU_COOKIE_SECURE=false
# Used by the Next.js server to reach the API
API_URL=http://localhost:8000
POSTGRES_PASSWORD=xau
